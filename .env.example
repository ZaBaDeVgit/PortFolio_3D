# Leave empty for local development and root/custom-domain deployments.
# GitHub Actions automatically sets this to /PortFolio_3D for Pages.
NEXT_PUBLIC_BASE_PATH=

# Optional. Without all three values, the contact form prepares a draft only.
# EmailJS public browser identifiers, NOT a private API key.
# Configure the template with: name, email, reply_to, message.
# Restrict allowed origins in EmailJS to your production domain.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
